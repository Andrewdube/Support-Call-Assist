# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
ANALYSIS_INTERVAL_SEC=8

# --- Azure AI Speech (live transcription with speaker separation) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US
# Leave blank for default mic. For softphone calls use a loopback/virtual device id
AUDIO_INPUT_DEVICE=

# --- Microsoft Dynamics 365 (leave blank to run in dry-run mode) ---
DYNAMICS_URL=https://yourorg.crm.dynamics.com
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AUTO_CREATE_CASE=true
ATTACH_TRANSCRIPT_NOTE=true

# --- Knowledge base ---
KB_FOLDER=kb
SYNC_DYNAMICS_KB=true
